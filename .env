# Server Configuration
PORT=5055
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ngo_db

# Cloudinary Integration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# UpesiPay Integration (M-PESA STK Push Collections)
# Obtain your Channel ID and Auth Token from your UpesiPay Dashboard (https://upesipay.com)
UPESIPAY_CHANNEL_ID=your_channel_id
UPESIPAY_AUTH_TOKEN=your_basic_auth_token
UPESIPAY_CALLBACK_URL=https://your-domain.com/api/donation/webhook

# Admin Dashboard Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
JWT_SECRET=generate_a_random_secure_secret_key_here
