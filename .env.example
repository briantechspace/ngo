# ==============================================================================
# ENVIRONMENT & RUNTIME CONFIGURATION
# ==============================================================================
# Set to 'production' on live deployment (enables HSTS, asset caching, strict headers)
NODE_ENV=production
PORT=5055

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# Format: postgres://username:password@host:port/database
# Example (Supabase / Render / Neon): postgresql://user:pass@ep-xyz.us-east-1.aws.neon.tech/ngo_db?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ngo_db
# Set DATABASE_SSL=true for managed cloud providers (Render, Supabase, Neon, Heroku)
DATABASE_SSL=false
# Maximum concurrent pool connections (default 20)
DB_POOL_MAX=20
# Set to true ONLY if you want to bypass PostgreSQL and use in-memory mock storage
USE_MOCK_DB=false

# ==============================================================================
# MEDIA STORAGE (Cloudinary CDN)
# ==============================================================================
# If left blank or unconfigured, uploads will automatically fall back to local disk (/public/uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================================================
# PAYMENT GATEWAY (UpesiPay - M-PESA STK Push Collections)
# ==============================================================================
# Sign in to https://upesipay.com to get your Channel ID and Basic Auth token
UPESIPAY_CHANNEL_ID=your_channel_id
UPESIPAY_AUTH_TOKEN=your_basic_auth_token
# Public HTTPS Webhook endpoint where UpesiPay will POST transaction completion callbacks
UPESIPAY_CALLBACK_URL=https://your-domain.com/api/donation/webhook

# ==============================================================================
# ADMIN AUTHENTICATION & SECURITY
# ==============================================================================
ADMIN_USERNAME=admin
# Supports plain text password OR PBKDF2 hash (format: pbkdf2:<salt>:<hex_key>)
ADMIN_PASSWORD=eco_admin_2026

# Generate a cryptographically strong secret for HMAC session tokens:
# In powershell/node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_64_character_random_hex_string_in_production
